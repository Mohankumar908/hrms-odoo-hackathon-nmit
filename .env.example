# ============================================================
# DAYFLOW HRMS - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Django
DJANGO_SECRET_KEY=your-very-secret-key-here-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django settings module
DJANGO_SETTINGS_MODULE=dayflow.settings.development

# Database (PostgreSQL for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dayflow_db
DB_USER=dayflow_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# SQLite (for local dev - override DB_ENGINE below)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=DAYFLOW HRMS <noreply@dayflow.com>

# Frontend base URL (for email links)
FRONTEND_URL=http://localhost:8000

# Media / Static
MEDIA_URL=/media/
STATIC_URL=/static/

# JWT Token lifetimes (in minutes / days)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
